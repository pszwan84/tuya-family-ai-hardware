{
  "name": "family-ai-hardware",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w @fah/contracts && npm run build -w @fah/config && npm run build -w @fah/domain && npm run build -w @fah/ai && npm run build -w @fah/pipeline && npm run build -w @fah/api && npm run build -w @fah/worker && npm run build -w @fah/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:api": "npm run dev -w @fah/api",
    "dev:worker": "npm run dev -w @fah/worker",
    "dev:web": "npm run dev -w @fah/web",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "demo:seed": "tsx infra/scripts/seed-demo.ts",
    "demo:reset": "tsx infra/scripts/reset-demo.ts",
    "demo:verify": "tsx infra/scripts/verify.ts",
    "mock:device": "tsx infra/scripts/mock-device.ts"
  },
  "devDependencies": {
    "@prisma/client": "^6.2.1",
    "prisma": "^6.2.1",
    "sharp": "^0.33.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}